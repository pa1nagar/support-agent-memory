# Environment Configuration
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# CockroachDB Connection
# Get from: https://cockroachlabs.cloud/cluster/YOUR_CLUSTER/connect
COCKROACHDB_URL=postgresql://user:password@cluster.cockroachlabs.cloud:26257/defaultdb?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# AWS Bedrock Configuration
# Region where Bedrock is available
AWS_REGION=us-east-1

# Claude model - use inference profile ID
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Titan Embeddings V2 - outputs 1024 dimensions
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Memory Retrieval Settings
MEMORY_RETRIEVAL_LIMIT=5
MEMORY_SIMILARITY_THRESHOLD=0.7

# API Settings
CORS_ORIGINS=*
MAX_REQUEST_SIZE=1048576
