# ============================================
# Environment Variables for Support Agent Memory
# Copy this file to .env and fill in your values
# ============================================

# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# CockroachDB Connection
# Get this from: https://cockroachlabs.cloud/cluster/YOUR_CLUSTER_ID/connection
COCKROACHDB_URL=postgresql://username:password@your-cluster.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full

# Database Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# AWS Configuration
AWS_REGION=us-east-1

# AWS Bedrock Models
# Claude 4.5 Sonnet (latest - use if you have access)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-v1:0
# Alternative: Claude 3.5 Sonnet (if Claude 4.5 not available)
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Memory Retrieval Settings
MEMORY_RETRIEVAL_LIMIT=5
MEMORY_SIMILARITY_THRESHOLD=0.7

# API Settings
CORS_ORIGINS=*
MAX_REQUEST_SIZE=1048576

# ============================================
# AWS Credentials (for local testing only)
# In production, use IAM roles instead
# ============================================
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here

# ============================================
# Notes:
# - Never commit .env file to git
# - Use AWS Secrets Manager in production
# - CockroachDB URL format: postgresql://user:pass@host:26257/db?sslmode=verify-full
# ============================================
